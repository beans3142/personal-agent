{
  "enabledPlugins": {
    "discord@claude-plugins-official": true
  },
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md",
    "**/univ/CLAUDE.md"
  ],
  "autoMemoryEnabled": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(python tools/transcribe.py *)",
      "Bash(python tools/speak.py *)",
      "mcp__plugin_discord_discord__reply",
      "mcp__plugin_discord_discord__react",
      "mcp__plugin_discord_discord__edit_message",
      "mcp__plugin_discord_discord__fetch_messages",
      "mcp__plugin_discord_discord__download_attachment"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(~/.claude/channels/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Edit(~/.claude/channels/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
