[Unit]
Description=Android (Waydroid) without a screen
After=network-online.target waydroid-container.service user@1000.service
Wants=waydroid-container.service user@1000.service

[Service]
Type=oneshot
RemainAfterExit=true
User=ubuntu
ExecStartPre=+/sbin/modprobe binder_linux
ExecStart=/bin/bash /home/ubuntu/personal-agent/deploy/start-android.sh
TimeoutStartSec=480

[Install]
WantedBy=multi-user.target
