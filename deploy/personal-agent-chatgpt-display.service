[Unit]
Description=Daevis private display for the ChatGPT desktop app

[Service]
User=ubuntu
ExecStart=/usr/bin/Xvfb :4 -screen 0 1280x900x24 -nolisten tcp
ExecStartPost=/usr/bin/timeout 10 /bin/sh -c 'until test -S /tmp/.X11-unix/X4; do sleep 0.1; done'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
